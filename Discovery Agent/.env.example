# Google AI Studio API key for Gemini chat and embeddings. Supply at runtime.
GEMINI_API_KEY=

# Shopify Global Catalog market localization (ISO country/currency).
SHOPIFY_CATALOG_COUNTRY=US
SHOPIFY_CATALOG_CURRENCY=USD

# Optional hosted UCP agent profile; Shopify's example profile is used by default.
SHOPIFY_UCP_AGENT_PROFILE=
