# Supply this at runtime; never commit a real token.
HF_TOKEN=

# Optional market localization for Shopify Global Catalog (ISO country/currency).
SHOPIFY_CATALOG_COUNTRY=US
SHOPIFY_CATALOG_CURRENCY=USD

# Optional: use your own hosted UCP agent profile instead of Shopify's example profile.
SHOPIFY_UCP_AGENT_PROFILE=

# Optional eBay Browse API. Create production keys in the eBay Developers Program.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Optional Amazon Creators API. Requires Associates enrollment, API approval,
# a qualifying sales history, credentials, and a marketplace partner tag.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CREDENTIAL_REGION=NA

# Optional Google Vertex AI Search for commerce (your ingested product catalog only).
# Use Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS for auth.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_CATALOG_ID=default_catalog
GOOGLE_CLOUD_SERVING_CONFIG=default_search
# Optional service-account JSON for Streamlit Cloud; otherwise use ADC/workload identity.
GOOGLE_SERVICE_ACCOUNT_INFO=